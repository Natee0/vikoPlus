{
  "name": "vikoplus",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/super-admin"
  ],
  "scripts": {
    "api:dev": "npm --workspace apps/api run start:dev",
    "api:test": "npm --workspace apps/api test",
    "api:lint": "npm --workspace apps/api run lint",
    "api:prisma:generate": "npm --workspace apps/api run prisma:generate",
    "super-admin:dev": "npm --workspace apps/super-admin start",
    "super-admin:build": "npm --workspace apps/super-admin run build",
    "android:get": "cd apps/vikoPlus && flutter pub get",
    "android:test": "cd apps/vikoPlus && flutter test",
    "android:analyze": "cd apps/vikoPlus && flutter analyze",
    "android:build:debug": "cd apps/vikoPlus && flutter build apk --debug --target-platform android-arm64 --no-pub",
    "android:build:release": "cd apps/vikoPlus && flutter build apk --release --no-pub",
    "android:uninstall": "adb uninstall com.vikoplus",
    "android:run": "cd apps/vikoPlus && flutter run --target-platform android-arm64 --no-pub"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "class-validator": "^0.14.4",
    "effect": "^3.21.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "caniuse-lite": "^1.0.30001810"
  }
}
