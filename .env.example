NODE_ENV=development
API_PORT=3000
API_HOST_BIND=127.0.0.1
API_PUBLIC_PORT=3002
DATABASE_URL=postgresql://vikoplus:vikoplus@localhost:5432/vikoplus?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=true
ENABLE_SWAGGER=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_BLOCK_DURATION_MS=60000
BILLING_PROVIDER=sayari
SAYARI_PAYMENT_BASE_URL=https://payments.example.com
SAYARI_PAYMENT_API_KEY=replace-with-sayari-payment-api-key
SAYARI_PAYMENT_CALLBACK_SECRET=replace-with-sayari-callback-secret
BRIQ_BASE_URL=https://karibu.briq.tz
BRIQ_API_KEY=replace-with-briq-api-key
BRIQ_SENDER_ID=VIKOPLUS
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=vikoPlus <noreply@sayarisoftware.com>
OBJECT_STORAGE_DRIVER=local
DEFAULT_LOCALE=en
